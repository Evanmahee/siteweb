# EmailJS — envoi du formulaire contact (https://www.emailjs.com/)
# 1. Créer un compte, un service Gmail, un template avec les variables ci-dessous
# 2. Récupérer Public Key, Service ID et Template ID dans le dashboard EmailJS
# Variables du template : prenom, nom, email, reply_to, telephone, age, genre,
# taille_cm, poids_kg, metier, jours_travail, source, source_autre_detail,
# objectif_principal, objectifs_detail, niveau_muscu, annees_muscu, autres_sports,
# seances_semaine, moment_entrainement, moments_impossibles, cardio, pathologies,
# antecedents_familiaux, activite_hors_sport, extremites_froides, perte_cheveux,
# reglee, duree_cycles, spm, contraception, alimentation_journee, repas_plusieurs,
# appetit, aliments_indispensables, aliments_detestes, digestif, eau_litres,
# complements, suivi_passe, estime_amour_propre, estime_image_corporelle, confiance,
# responsabilite_resultats, engagement, soutien_entourage, vie_travail, vie_famille,
# vie_epanouissement, vie_sociale, type_accompagnement, budget_mensuel, message

VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Google Places API (nouvelle API) — pour synchroniser les avis automatiquement
# 1. Créer une clé sur https://console.cloud.google.com/ (activer "Places API (New)")
# 2. Trouver le Place ID : fiche Google Maps → Partager → l'ID est dans l'URL (ChIJ…)
#    ou via https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
